# Somente desenvolvimento local. Copie para backend/.env.
DJANGO_SETTINGS_MODULE=config.settings.local
# Gere chaves persistentes com infra/setup_local.py; nunca versionar valores reais.
DJANGO_SECRET_KEY=
IDENTITY_ENCRYPTION_KEY=
IUSTUS_PROXY_SECRET=
DATABASE_URL=postgresql://iustus:iustus-local-only@127.0.0.1:5432/iustus
# ClamAV em loopback/rede privada. Indisponibilidade mantém arquivos bloqueados.
DOCUMENT_SCANNER_HOST=127.0.0.1
DOCUMENT_SCANNER_PORT=3310

IUSTUS_PUBLIC_ORIGIN=http://localhost:3000
IUSTUS_INITIAL_ADMIN_EMAIL=

# Exigir autenticador no acesso da equipe; false permite testes com senha.
IDENTITY_MFA_REQUIRED=true
# Adesão anual: habilitar somente após homologar o checkout e as notificações.
BILLING_ENABLED=false
# Exibir continuidade para checkout web no mobile, após definir o canal de distribuição.
MOBILE_EXTERNAL_CHECKOUT_ENABLED=false
PAGBANK_ENVIRONMENT=sandbox
PAGBANK_API_TOKEN=
# Chave pública X.509 Base64 consultada no PagBank (type=webhook).
PAGBANK_WEBHOOK_PUBLIC_KEY=
