{
  "name": "iustus",
  "version": "1.0.0",
  "private": true,
  "description": "Repositório único do frontend, backend e infraestrutura Iustus",
  "scripts": {
    "local:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/start-local.ps1",
    "local:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/stop-local.ps1",
    "mobile:start": "npm --prefix mobile start",
    "mobile:check": "npm --prefix mobile run typecheck && npm --prefix mobile run lint && npm --prefix mobile test",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:documents": "node --test tests/frontend/documents.test.cjs",
    "frontend:install": "npm --prefix frontend ci",
    "docs:generate": "node docs/planejamento/gerar.cjs",
    "docs:check": "node docs/planejamento/verificar.cjs"
  }
}
