# Aplicar no backend e worker. Não preencher este arquivo versionado com segredos.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
IDENTITY_ENCRYPTION_KEY=
IUSTUS_PROXY_SECRET=
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=
IUSTUS_PUBLIC_ORIGIN=https://iustus-defesa-juridica.vercel.app
IUSTUS_INITIAL_ADMIN_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
REGISTRATION_POLICY_VERSION=web-evaluation-v1

# PagBank: os mesmos valores na API e no worker; token nunca vai para o frontend.
BILLING_ENABLED=false
PAGBANK_ENVIRONMENT=sandbox
PAGBANK_API_TOKEN=
PAGBANK_WEBHOOK_PUBLIC_KEY=

# Somente no frontend Vercel, além da origem pública e da chave de proxy acima:
DJANGO_API_ORIGIN=

# Documentos: manter disabled até homologar transporte de arquivos, bucket e scanner.
# Aplicar os mesmos valores na API e no worker.
DOCUMENT_STORAGE_BACKEND=disabled
DOCUMENT_DIRECT_UPLOAD_ENABLED=false
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_PREFIX=iustus/objects
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
DOCUMENT_S3_ADDRESSING_STYLE=auto
DOCUMENT_SCANNER_HOST=
DOCUMENT_SCANNER_PORT=3310
